{
  "name": "dsh-session-slim",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Open-time session slimming for DSH: materialize the official surface as the stored log, archive the original.",
  "bin": {
    "dsh-session-slim": "./bin/slim.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "smoke": "node ./test/smoke.mjs"
  },
  "exports": {
    ".": "./plugin/index.js",
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./bin/*": "./bin/*"
  },
  "files": [
    "plugin/index.js",
    "src/*.mjs",
    "bin/*.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
